<Project Sdk="Microsoft.NET.Sdk">

  <!--
    پروژه‌ی Class Library — نسخه‌ی SOAP v2 مگفا
    خروجی فقط یک فایل است:
      bin\Debug\net48\MagfaSmsSoap.dll      (بیلد Debug)
      bin\Release\net48\MagfaSmsSoap.dll    (بیلد Release)
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MagfaSmsSoap</AssemblyName>
    <RootNamespace>MagfaSms.Soap</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>کلاینت C# برای سرویس SOAP v2 مگفا (Magfa SMS) — یک DLL مستقل</Description>

    <!-- خروجی را تمیز نگه می‌دارد: فقط MagfaSmsSoap.dll -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- اسمبلی‌های داخلی .NET Framework — هیچ وابستگی NuGet خارجی ندارد -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
